[Unit]
Description=Discussion Board app (gunicorn)
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/discussion-board-monolith
EnvironmentFile=/home/ec2-user/discussion-board-monolith/.env

# Wait for the database before starting the application.
ExecStartPre=/home/ec2-user/discussion-board-monolith/.venv/bin/python /home/ec2-user/discussion-board-monolith/scripts/wait_for_mysql.py --timeout 60

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

ExecStart=/home/ec2-user/discussion-board-monolith/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:80 discussion_board.app:app

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target